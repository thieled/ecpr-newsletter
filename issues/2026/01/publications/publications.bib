@article{herbig2025JustifyingEuropean,
  title = {Justifying {{European}} border policies: a quantitative content analysis of {{German}} government communication 2013-2023},
  shorttitle = {Justifying {{European}} border policies},
  author = {Herbig, Lisa and Eisele, Olga and Gattermann, Katjana and Kuhn, Theresa},
  year = 2025,
  month = dec,
  journal = {Journal of European Public Policy},
  volume = {0},
  number = {0},
  pages = {1--36},
  publisher = {Routledge},
  issn = {1350-1763},
  doi = {10.1080/13501763.2025.2599361},
  urldate = {2026-01-19},
  abstract = {Under the Schengen Agreement, member states agreed to abolish internal border controls to ensure free movement. While the reintroduction of internal border controls is foreseen only in exceptional circumstances, states increasingly invoke their right to unilaterally reintroduce border controls. This is at odds with a core principle of the EU: free movement. In this paper, we examine different strategies that public officials use to justify the introduction and removal of border controls. Grounded in the concept of democratic accountability, it argues that political justifications are essential to secure public legitimacy and support. Using a novel dataset of German government communications, including speeches and press conferences from 2013 to 2023, we conduct a quantitative content analysis with an inductively developed coding scheme. We then apply hierarchical cluster analysis to identify officials' justification strategies within the coded data. Based on the cluster analysis results, we identify a multi-dimensional, context-dependent typology of justifications, revealing four approaches: Legal-Solidarity, Security-Enforcement, Public-Health-Emergency, and Critical-Evaluation. German government actors vary their justification strategies based on roles and crises. Notably, while Legal-Solidarity remains stable, Security-Enforcement and Public-Health-Emergency increase strategically during crises. These insights show how national governments in the EU aim to maintain democratic accountability through public justification.},
  keywords = {COVID-19 pandemic,democratic accountability,EU border policies,policy justification,Schengen}
}

@article{milzner2025JustTip,
  title = {Just the tip of the iceberg? {{State}} of the art of coordinated social media manipulation research},
  shorttitle = {Just the tip of the iceberg?},
  author = {Milzner, Miriam and Thiele, Daniel and Gong, Baoning},
  year = 2025,
  month = dec,
  journal = {Information, Communication \& Society},
  volume = {0},
  number = {0},
  pages = {1--20},
  publisher = {Routledge},
  issn = {1369-118X},
  doi = {10.1080/1369118X.2025.2596873},
  urldate = {2026-01-07},
  abstract = {Social media environments are increasingly exploited by manipulative actors through coordinated social media manipulation (CSMM) campaigns: the intentional and deceptive orchestration of social media networks to manipulate content visibility and public opinion formation. In recent years, research on CSMM has grown rapidly, and the field lacks a systematic synthesis of empirical findings on observed campaigns. This study addresses that gap through a systematic review of 83 studies sourced from Web of Science and EBSCOHost, each analyzing observed digital traces of CSMM. We introduce a conceptual model that frames CSMM as a three-step process: covert operation, implementation, and influence. Using this model, we map the existing research findings, identify critical gaps, and outline future research directions. The review shows that research disproportionately focuses on election periods, state-backed actors, and text-based content on Twitter/X while overlooking multimodal forms, platform-specific manipulation strategies, and broader geopolitical contexts. Linking online campaigns to offline actors, as well as assessing the impact of CSMM, also remain challenges. Overall, we call for integrative analytical frameworks that incorporate comparative designs, cross-platform and multilingual analyses, and greater attention to the dynamics of audience interaction.},
  keywords = {coordination,disinformation,manipulation,social media,systematic literature review}
}

